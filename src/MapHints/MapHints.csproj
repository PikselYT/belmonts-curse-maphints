<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MapHints</AssemblyName>
    <RootNamespace>MapHints</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NETSDK1138;CS8981</NoWarn>
    <!-- Override with: dotnet build -p:GameDir="D:\Games\Castlevania Belmont's Curse\" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Castlevania Belmont's Curse\</GameDir>
    <GameRoot>$([MSBuild]::EnsureTrailingSlash('$(GameDir)'))</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx -->
    <Reference Include="BepInEx.Core"><HintPath>$(GameRoot)BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(GameRoot)BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(GameRoot)BepInEx\core\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameRoot)BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(GameRoot)BepInEx\core\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <!-- Game / Unity (generated by BepInEx on the first launch) -->
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)BepInEx\interop\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MotherBase.RoomDesigner"><HintPath>$(GameRoot)BepInEx\interop\MotherBase.RoomDesigner.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MotherBase.EntityFramework"><HintPath>$(GameRoot)BepInEx\interop\MotherBase.EntityFramework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SerializableDictionary"><HintPath>$(GameRoot)BepInEx\interop\SerializableDictionary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameRoot)BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRoot)BepInEx\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(GameRoot)BepInEx\interop\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copy the built plugin straight into the game (skip with -p:Deploy=false; build.ps1 does that) -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false' And Exists('$(GameRoot)BepInEx\plugins')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameRoot)BepInEx\plugins\$(AssemblyName)\" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll to $(GameRoot)BepInEx\plugins\$(AssemblyName)\" />
  </Target>

</Project>
